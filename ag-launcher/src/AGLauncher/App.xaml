<Application x:Class="AGLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#EEE0C4"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F8EFD9"/>
        <SolidColorBrush x:Key="BrownBrush" Color="#4A2F1E"/>
        <SolidColorBrush x:Key="DarkBrush" Color="#21170F"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#B47A39"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B725C"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrownBrush}"/>
            <Setter Property="Foreground" Value="#FFF8E7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderBrush" Value="#C7A97C"/>
            <Setter Property="Background" Value="#FFF9EB"/>
        </Style>
    </Application.Resources>
</Application>
