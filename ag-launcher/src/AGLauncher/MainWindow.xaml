<Window x:Class="AGLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AG Launcher — Atenoct Games Launcher" Height="800" Width="1320" MinHeight="680" MinWidth="1050" WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" KeyDown="Window_KeyDown">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
  <Border Background="#2B1C13" Padding="18">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="64" Height="64" CornerRadius="8" Background="#C69857" Margin="0,0,14,0"><Grid><TextBlock Text="AG" FontSize="27" FontWeight="Bold" Foreground="#2B1C13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="AG LAUNCHER" Foreground="#F2DDB8" FontSize="27" FontWeight="Bold"/><TextBlock Text="ATENOCT GAMES LAUNCHER" Foreground="#B99B74" FontSize="11"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="DiscordButton" Content="DISCORD" Tag="discord" Click="Social_Click"/><Button x:Name="TelegramButton" Content="TELEGRAM" Tag="telegram" Click="Social_Click"/><Button x:Name="YouTubeButton" Content="YOUTUBE" Tag="youtube" Click="Social_Click"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="10" Margin="0,0,12,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="GAMES" FontWeight="Bold" Margin="6,4,6,10"/><ListBox x:Name="GamesList" Background="Transparent" BorderThickness="0" SelectionChanged="GamesList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Background="#F0DFC0" CornerRadius="7" Padding="11" Margin="2,4"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/><TextBlock Text="{Binding Status}" Foreground="#8B725C" FontSize="11"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
   <Border Grid.Column="1" Background="#E3CFA9" CornerRadius="10" Padding="26" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="GameStatusText" Text="ATENOCT GAMES" Foreground="#8C5B2F" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="GameTitleText" Text="AG Launcher" FontSize="42" FontWeight="Bold" Foreground="#2A1B12" Margin="0,8,0,10"/><TextBlock x:Name="GameDescriptionText" Text="Select a game." FontSize="16" Foreground="#5D4634" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock x:Name="InstallStatusText" Foreground="#6F5138" FontSize="12"/><ProgressBar x:Name="InstallProgress" Height="7" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,5,0,8"/><Button x:Name="GameActionButton" Content="SELECT GAME" Height="46" MinWidth="190" HorizontalAlignment="Left" Click="GameActionButton_Click"/></StackPanel>
   </Grid></Border>
   <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="4,0,4,8"><TextBlock Text="NEWS" FontWeight="Bold"/><TextBlock Text="Latest from Atenoct Games" Foreground="#8B725C" FontSize="11"/></StackPanel><ListBox x:Name="NewsList" Background="Transparent" BorderThickness="0" MouseDoubleClick="NewsList_MouseDoubleClick"><ListBox.ItemTemplate><DataTemplate><Border Background="#F0DFC0" CornerRadius="7" Padding="11" Margin="1,5"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Foreground="#6F5A48" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,4"/><TextBlock Text="{Binding Date}" Foreground="#9A7F65" FontSize="10"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
  </Grid>
  <Border Grid.Row="2" Background="#DDC69E" Padding="14,0"><Grid><TextBlock x:Name="ConnectionText" Text="Connecting to GitHub..." VerticalAlignment="Center"/><TextBlock Text="Ctrl + Shift + A" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8B725C" FontSize="10"/></Grid></Border>
 </Grid>
</Window>
