<Window x:Class="AGLauncher.AdminWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AG Launcher — Admin Panel" Width="1080" Height="720" WindowStartupLocation="CenterOwner" Background="#EEE0C4">
 <DockPanel Margin="16">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ADMIN PANEL" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="RepoText" Foreground="#8B725C"/></StackPanel><Button Grid.Column="1" Content="SAVE TO GITHUB" Click="Save_Click" Padding="22,12"/></Grid>
  <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="4,10,4,0" Foreground="#6F5138"/>
  <TabControl Background="#F8EFD9">
   <TabItem Header="SOCIAL LINKS"><Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Discord" VerticalAlignment="Center"/><TextBox x:Name="DiscordBox" Grid.Column="1"/>
    <TextBlock Grid.Row="1" Text="Telegram" VerticalAlignment="Center"/><TextBox x:Name="TelegramBox" Grid.Row="1" Grid.Column="1"/>
    <TextBlock Grid.Row="2" Text="YouTube" VerticalAlignment="Center"/><TextBox x:Name="YouTubeBox" Grid.Row="2" Grid.Column="1"/>
   </Grid></TabItem>
   <TabItem Header="NEWS"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="+ ADD NEWS" Click="AddNews_Click"/><Button Content="REMOVE SELECTED" Background="#80533B" Click="RemoveNews_Click"/></StackPanel><DataGrid x:Name="NewsGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,12"><DataGrid.Columns><DataGridCheckBoxColumn Header="PIN" Binding="{Binding Pinned}" Width="45"/><DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="90"/><DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="180"/><DataGridTextColumn Header="SUMMARY" Binding="{Binding Summary}" Width="*"/><DataGridTextColumn Header="IMAGE URL" Binding="{Binding ImageUrl}" Width="180"/><DataGridTextColumn Header="LINK URL" Binding="{Binding LinkUrl}" Width="180"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
   <TabItem Header="GAMES"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="+ ADD GAME" Click="AddGame_Click"/><Button Content="REMOVE SELECTED" Background="#80533B" Click="RemoveGame_Click"/></StackPanel><DataGrid x:Name="GamesGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,12"><DataGrid.Columns><DataGridCheckBoxColumn Header="VISIBLE" Binding="{Binding Visible}" Width="60"/><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120"/><DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="PRICE" Binding="{Binding Pricing}" Width="70"/><DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="MANIFEST URL" Binding="{Binding ManifestUrl}" Width="220"/><DataGridTextColumn Header="BANNER URL" Binding="{Binding BannerUrl}" Width="180"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
